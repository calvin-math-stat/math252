\begin{problem}
  Let $L$ be the language that contains all and only binary
  strings that
\begin{itemize}
\item
contain two (or more) consecutive 0s,
\item contain at most one 1.
\end{itemize}

(So $0100 \in L$ and $0000 \in L$, but $10100 \not\in L$ and $010 \not\in L$.)

%\begin{enumerate}
%\item
Design a DFA that accepts the language $L$. (Partial credit for an NFA.)

[Hint: Use meaningful state names. It will help you and makes it easier to get
partial credit.]
      \vfill
      \vfill
      \vfill


%    \item
%      Construct a regular expression for $L$.  (You \underline{do not} have to use
%      the algorithm that converts any DFA into a regular expression. Just
%      come up with some correct regular expression.)
%      \vfill
%      \vfill
%  \end{enumerate}
\end{problem}

\begin{problem}
Show that if $A$ is a regular language,
then the complement of $A$ is also regular.
(We can denote the complement of $A$ as $\overline{A} = A^c = \{x \mid x\not \in A\}$.)
\vfill
\vfill
\end{problem}


\newpage

\begin{problem}
We learned an algorithm for converting any DFA into a regular expression.
This problem asks you a few questions about that algorithm.

\begin{enumerate}
\item In the first phase of the algorithm,
we must modify the automaton to make sure it
satisfies some properties that are necessary for the algorithm to work correctly.
What are those properties?
\vfill
\vfill
\item Demonstrate how to do the first phase using the DFA below.

\begin{tikzpicture}[->,>=stealth',shorten >=1pt,auto,node distance=2.8cm,
                    semithick,scale=0.8]
  \tikzstyle{every state}=[fill=none,draw=black,text=black]
  \tikzstyle{every node}=[scale = 0.7]

  \node[state,initial,accepting]    (A)              {$a$};
  \node[state]            (B) [right of=A] {$b$};
  \node[state,accepting]  (C) [below of=B] {$c$};

  \path (A) edge              node {0} (B);
  \path (B) edge              node {0} (C);
  \path (C) edge              node {0,1} (A);
  \path (B) edge [loop above] node {1} (B);
  % \path (C) edge [loop below] node {0} (C);
  \path (A) edge [loop above] node {1} (A);
\end{tikzpicture}


\vfill
\vfill
\item In the second phase, states are ``ripped out" of a GNFA until
only two states remain.  Using that process, show what happens
when state $a$ is ripped out of the GNFA shown below.  (You don't have to complete
the process, just do this one step.)

\begin{tikzpicture}[->,>=stealth',shorten >=1pt,auto,node distance=2.8cm,
                    semithick,scale=0.7]
  \tikzstyle{every state}=[fill=none,draw=black,text=black]
  \tikzstyle{every node}=[scale=0.7]

  \node[]  (X) {};
  \node[state,initial]    (S) [left of=X]  {$s$};
  \node[state]            (A) [above of=X] {$a$};
  \node[state]            (C) [below of=X] {$c$};
  \node[state,accepting]  (T) [right of=X] {$t$};

  \path (A) edge [bend left]  node {$\mybold{\lambda}$} (T);
  \path (C) edge [bend right] node {$\mybold{\lambda}$} (T);
  \path (S) edge [bend left]  node {$\mybold{\lambda}$} (A);
  \path (A) edge [bend left]  node {$\mybold{01}^*\mybold{0}$} (C);
  \path (C) edge [bend left]  node {$(\mybold{0} \cup \mybold{1})$} (A);
  % \path (C) edge [loop below] node {$\mybold{0}$} (C);
  \path (A) edge [loop above] node {$\mybold{1}$} (A);
\end{tikzpicture}

\vfill
\vfill

\end{enumerate}
\end{problem}

