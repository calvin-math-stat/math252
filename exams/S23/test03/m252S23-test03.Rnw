\begin{problem}
The production rules for a grammar $G$ with start symbol $S$,
terminals $a$, $b$, and $c$ and
non-terminals $X$, $Y$, and $Z$ is given below:
\[
\begin{array}{rclrcl}
G: \qquad
S & \rightarrow & XY  & & & \\
X & \rightarrow & a & X & \rightarrow & YZ \\
Y & \rightarrow & b & Y & \rightarrow & ZX \\
Z & \rightarrow & c & Z & \rightarrow & XY \\
\end{array}
\]
% \begin{enumerate}
% \item
%S -> XY -> aY -> aZX -> aZYZ -> aZYXY -> acbab
%S -> XY -> YZY -> YXYY -> YXZXY -> bacab
%S -> XY -> YZY -> ZXZY -> XYXZY -> abacb
\ifversionA
\def\target{bacab}
\else
\def\target{abacb}
\fi
\begin{enumerate}
\item
% Give either a derivation or a derivation tree
% that shows
Show that $G$ generates $\target$
(i.e., that $S \stackrel*{\Rightarrow} \target$).
\vfill
\vfill
\vfill
%\item
%Give a left-most derivation that shows that
%$G \stackrel*{\Rightarrow} babb$.
%\item
%Show that $G$ is an ambiguous grammar.
%\item
%Use a systematic method to construct a PDA that recognizes the
%language that $G$ generates.
\item
 Is $G$ a regular grammar?  Explain.
\vfill
\item
 Is $G$ a type 2 (context free) grammar?  Explain.
\vfill
\end{enumerate}
\end{problem}

