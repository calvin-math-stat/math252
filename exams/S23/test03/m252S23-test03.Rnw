  \tikzstyle{every node}=[scale = 0.7]

  \node[state,initial]    (A)              {$F$};
  \node[state,accepting]  (B) [above right of=A] {$G$};
  \node[state]  (C) [below right of=B] {$H$};

  \path (A) edge [bend left] node {1} (B);
  \path (B) edge [bend left] node {1} (C);
  \path (C) edge [bend left] node {1} (A);
  \path (A) edge [loop below] node {0} (A);
  \path (B) edge [bend left] node {0} (A);
  \path (C) edge [bend left] node {0} (B);
\end{tikzpicture}
\newpage
