\begin{problem}
Each of these problems deals with probabilities when
\textbf{four 4-sided dice} are rolled.
\begin{enumerate}
\item How many dice are being rolled?
\vfill
\item How many sides does each die have?
\vfill
\item
What is the probability that the four numbers rolled
will \textbf{all be the same}?
\vfill
\vfill
\item
What is the probability that the four numbers rolled will
be \textbf{distinct}? (four different numbers, no repetitions)
\vfill
\vfill
\item
What is the probability that at least one 1 and at least one 2 are rolled?
\vfill
\vfill
% \item
% If at least one 1 and at least one 2 are rolled,
% what is the probability that all four numbers will be distinct?
% \vfill
% \vfill
\end{enumerate}
\end{problem}

\begin{solution}
<<>>=
# all the same
4 / 4^4
# all distinct
4*3*2*1 / 4^4
# P(A) = P(at least one 1) = 1 - P(no 1's)
1 - (3/4)^4
# P(A and B) = P(A) + P(B) - P(A union B)
# = P(at least 1 1) + P(at least 1 2) - (1  - P(no 1's and no 2's))
(1 - (3/4)^4) * 2 - (1 - (1/2)^4)
(1 - (3/4)^4) * 2 - (1 - (1/2)^4) %>% fractions
@


\end{solution}


\newpage

\begin{problem}
The Sieben Siegel (Seven Seals) card game uses a non-standard deck.
The deck has \textbf{fifteen numbers} (1 -- 15) in each of
\textbf{five colors} (red, green, blue, yellow, and purple).
\begin{enumerate}
\item
How many cards are in the deck?

\vfill

\item
If you are dealt six cards, what is the probability that they are
\textbf{all the same color}?
\vfill
\ifversionFive
\item
If you are dealt six cards, what is the probabiilty that you have
\textbf{two trios}? (3 of one kind and 3 of another kind)
\else
\item
If you are dealt six cards, what is the probabiilty that you have
\textbf{3 pairs}?
(2 of one kind, 2 of a different kind, and 2 of a third kind)
\fi
\vfill
\ifversionFive
\item
If you are dealt six cards, what is the probabilty that you have
\textbf{3-of-a-kind}?
(3-of-a-kind means that 3 cards are the same number,
and the other three are different from each other and from the three that match.)
\else
\item
If you are dealt six cards, what is the probabilty that you have
\textbf{4-of-a-kind}?
(4-of-a-kind means that 4 cards are the same number, and the other two are different from each other and from the four that match.)
\fi
\vfill
\end{enumerate}
Go back and make sure you didn't slip back into standard deck mode anywhere.
\end{problem}

\begin{solution}
<<>>=
15 * 5
# 3 pairs
choose(15,3) * choose(5,2) * choose(5,2) * choose(5,2) / choose(75, 6)
# 2 trios
choose(15,2) * choose(5,3) * choose(5,3) / choose(75, 6)
# 4-of-a-kind
choose(15,1) * choose(5,4) * choose(14,2) * choose(5,1) * choose(5,1) / choose(75, 6)
# 3-of-a-kind
choose(15,1) * choose(5,3) * choose(14,3) * choose(5,1) * choose(5,1) * choose(5,1) / choose(75, 6)
@
\end{solution}


