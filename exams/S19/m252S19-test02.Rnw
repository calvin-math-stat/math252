\section*{Unused Problems}

\begin{problem}
Let $X \sim \Binom(\Sexpr{n[test_version]}, \Sexpr{p[test_version]})$.
%\begin{enumerate}
%\item
What is $\Prob(X = \Sexpr{k[test_version]})$?
\vfill
%\item
%What is $\E(X)$?
%\vfill
%\end{enumerate}
\end{problem}

\begin{solution}
<<>>=
dplyr::data_frame(
  n = n,
  p = p,
  k = k,
  prob = dbinom(k, n, p),
  E = n * p
)
@
\end{solution}


\begin{problem}
\textsc{Dice.}
\begin{enumerate}
\item
If you roll three standard dice (6 sides, each with equal probability),
what is the probability that all three numbers will be the same?
\vfill
\item
If you roll three standard dice,
what is the probability that the three numbers rolled will
be distinct (4 different numbers, no repetitions)?
\vfill
\item
If you roll three standard dice,
what is the probability that \textbf{at least one} of the numbers rolled is a \textbf{six}?
\vfill
\item
If you roll three standard dice, what is the probability that
\textbf{exactly one} of the numbers rolled is a \textbf{six}?
\vfill

\end{enumerate}
\end{problem}

\begin{problem}
One of the variations of the the Michigan Lottery Daily 4 game has two possible prizes.
The big prize is \$\Sexpr{prize[1]}.  The probability of winning this prize is $1/\Sexpr{denom[1]}$.
The smaller prize is \$\Sexpr{prize[2]}.
The probability of winning this prize is $1/\Sexpr{denom[2]}$.\footnote{%
This information is available on their website in a different form -- and has some errors because they
mix up odds and probability.  I've fixed those errors here.}
Of course, if you don't win one of those prizes, you get nothing.

Let $W$ be the amount of money won from one of these lottery tickets.

\begin{enumerate}
\item What is $\Prob(W = 0)$?
\vfill

\item What is the expected value of $W$?
\vfill

\item What does the expected value of $W$ tell us about this lottery game.  (Note: It costs \$1 to buy
one of these tickets).
\vfill

\item What is the variance of $W$?
\vfill

\end{enumerate}




\end{problem}





\vfill

\begin{problem}
The Five Crowns card game uses a non-standard deck.  The deck has \textbf{five suits} (clubs, diamonds, hearts,
spades, and stars).  Each suit has \textbf{11 kinds} (3 through King, there are no aces and no 2's).
There are also jokers, but for this problem they have been removed.
That leaves a deck with \textbf{55 cards}.
\begin{enumerate}
\item
If you are dealt six cards, what is the probability that they are all the same suit?
\vfill
\ifversionFive
\item
If you are dealt six cards, what is the probabiilty that you have two trios? (3 of one kind and 3 of another kind)
\else
\item
If you are dealt six cards, what is the probabiilty that you have 3 pairs? (2 of one kind,
2 of a different kind, and 2 of a third kind)
\fi
\vfill
\ifversionFive
\item
If you are dealt six cards, what is the probabilty that you have 3-of-a-kind?  (3-of-a-kind
means that 3 cards are the same kind, and the other three are different from each other and
from the 3 that match.)
\else
\item
If you are dealt six cards, what is the probabilty that you have 4-of-a-kind?  (4-of-a-kind
means that 4 cards are the same kind, and the other two are different from each other and
from the 4.)
\fi
\vfill
\end{enumerate}
Go back and make sure you didn't slip back into standard deck mode anywhere.
\end{problem}

\begin{solution}
<<>>=
choose(5,1) * choose(11,6) / choose(55, 6)
# 3 pairs
choose(11,3) * choose(5,2) * choose(5,2) * choose(5,2) / choose(55, 6)
# 2 trios
choose(11,2) * choose(5,3) * choose(5,3) / choose(55, 6)
# 4-of-a-kind
choose(11,1) * choose(5,4) * choose(10,2) * choose(5,1) * choose(5,1) / choose(55, 6)
# 3-of-a-kind
choose(11,1) * choose(5,3) * choose(10,3) * choose(5,1) * choose(5,1) * choose(5,1) / choose(55, 6)
@
\end{solution}


