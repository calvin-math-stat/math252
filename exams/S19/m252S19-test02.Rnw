<<include = FALSE>>=
options(scipen = 1000)
probAonly <- c(0.4, 0.3, 0.4, 0.4, 0.1)
probBonly <- c(0.3, 0.1, 0.1, 0.1, 0.2)
probAintB <- c(0.1, 0.3, 0.1, 0.2, 0.3)
probA <- probAonly + probAintB
probB <- probBonly + probAintB
BasicProb <-
  dplyr::tibble(
    probAUB = probA + probB - probAintB,
    probAgivenB = probAintB / probB,
    probBgivenA = probAintB / probA,
  )
BasicProb
@

\begin{problem}
Suppose
$\Prob(A) = \Sexpr{probA[test_version]}$,
$\Prob(B) = \Sexpr{probB[test_version]}$,
and
$\Prob(A \intersect B) = \Sexpr{probAintB[test_version]}$.

\begin{enumerate}
\item
What is $\Prob(A \union B)$?
\vfill

\item
What is $\Prob(A \mid B)$?
\vfill

\item
What is $\Prob(B \mid A)$?
\vfill

\item
Are events $A$ and $B$ \textbf{independent}? Explain how you know.
\vfill

\item
Are events $A$ and $B$ \textbf{mutually exclusive}? Explain how you know.
\vfill

\end{enumerate}
\end{problem}

\begin{solution}
<<>>=
BasicProb
@

\end{solution}

<<include = FALSE>>=
n_dice <- c(10, 11, 12, 13, 14)
n_six  <- c(3, 4, 4, 3, 4)
@
\begin{problem}
Terry rolls \Sexpr{n_dice[test_version]} standard (six-sided) dice.  What is the probability
that Terry rolls \textbf{exactly \Sexpr{n_six[test_version]}} 6's?
\vfill
\vfill
\end{problem}

\begin{solution}
<<>>=
dplyr::tibble(
  n_dice = n_dice,
  n_six  = n_six,
  prob   = dbinom(n_six, n_dice, 1/6),
  prob2  = choose(n_dice, n_six) * (1/6)^n_six * (5/6)^(n_dice - n_six))
@
\end{solution}

