\begin{problem}
Calvin has three hats.  Each hat contains some maroon and some gold marbles.
\begin{itemize}
\item
Hat A has 1 maroon and \Sexpr{ag[test_version]} gold.
\item
Hat B has 1 maroon and 1 gold.
\item
Hat C has \Sexpr{cm[test_version]} maroon and 1 gold.
\end{itemize}
Calvin randomly selects a hat (with equal probability) and then randomly selects
a marble from that hat.

\begin{enumerate}
\item
  Alltogether, there are \Sexpr{(4 + ag + cm)[test_version]} marbles.
  Explain why they are not equally likely to be selected.
\vfill
\vfill

\item
  What is the probability that the marble selected comes from hat $A$?
\vfill
\vfill

\item
  What is the probability that the selected marble is the maroon marble
  in hat A?
\vfill
\vfill

\item
  What is the probability that the selected marble is maroon (from any hat)?
\vfill
\vfill

\item
If the marble selected is maroon, what is the probability that the hat selected
is hat A?

\vfill
\vfill
\vfill
\item
  Let $M$ be the event that the marble selected is marroon.
  Let $A$ be the event that the hat selected is hat A.
  Circle the correct notation for the probabilities in parts b -- e above.

  \begin{center}
    \large
    \begin{tabular}{lcccccc}
      part b:& $\Prob(A)$ & $\Prob(M)$ & $\Prob(A \cap M)$ & $\Prob(A \cup M)$ & $\Prob(A \mid M)$ & $\Prob(M \mid A)$
      \\[7mm]
      part c: & $\Prob(A)$ & $\Prob(M)$ & $\Prob(A \cap M)$ & $\Prob(A \cup M)$ & $\Prob(A \mid M)$ & $\Prob(M \mid A)$
      \\[7mm]
      part d: & $\Prob(A)$ & $\Prob(M)$ & $\Prob(A \cap M)$ & $\Prob(A \cup M)$ & $\Prob(A \mid M)$ & $\Prob(M \mid A)$
      \\[7mm]
      part e: & $\Prob(A)$ & $\Prob(M)$ & $\Prob(A \cap M)$ & $\Prob(A \cup M)$ & $\Prob(A \mid M)$ & $\Prob(M \mid A)$
    \end{tabular}
  \end{center}
% \item
% What does it mean to say that two events are independent?
% Are the events $M$ and $A$ independent?
% \vfill
%
% \item
% What does it mean to say that two events are mutually exclusive?
% Are the events $M$ and $A$ mutually exclusive?
% \vfill
\end{enumerate}
\end{problem}

