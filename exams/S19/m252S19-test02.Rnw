\begin{problem}
  Consider the following game.  A player rolls two \textbf{fair four-sided}
  dice and wins the difference between the two values.  Here are a few examples:

  \begin{center}
    \begin{tabular}{cc}
      \hline
      roll & $W$ \\
      \hline
      $(2,2)$  & $0$ \\
      $(3,2)$  & $1$ \\
      $(2,4)$  & $2$ \\
      \hline
    \end{tabular}
  \end{center}
% (So a roll of two 2's wins nothing, but a roll of one 2 and one
% 4 wins \$2.)
Let the random variable $W$ be the amount won in a single play of the game.
\begin{enumerate}
\item
Here is the probability table for $W$.

	\begin{center}
		\large
		\begin{tabular}{|l||c|c|c|c|}
			\hline
			Value of $W$ & 0 & 1 & 2 & 3 \\
			\hline
			\hline
			Probability & 1/4 & 3/8 & 1/4 & 1/8 \\
			% Probability & \ \ \ \ \ \ \ \ \ \ \  & \ \ \ \ \ \ \ \ \ \ \  & \ \ \ \ \ \ \ \ \ \ \  & \ \ \ \ \ \ \ \ \ \ \  \\
			\hline
	\end{tabular}
	\end{center}
	Explain why $\Prob(W = 3) = 1/8$.
	\vfill
\item What is $\Prob(W > 1)$?
\vfill
\item
What is the expected value of $W$?
% What is the expected winnings per play (i.e., the expected value of $W$)?
\vfill
 \item
 What does the expected value of $W$ tell us about the game? (That is,
 how do you interpret the number you just calculated?)
 \vfill

 % If you have to pay \$1 for each roll to play, would
 % you expect to make money or lose money in the long run?
 % How much?  (Note: if you pay \$1 to play and then
 % roll $(1,2)$, you break even.)
\end{enumerate}
\end{problem}

