\begin{problem}
Let $f(n)$ be the number of multiplications and subtractions
(added together) used in the
following algorithm.
%(It only depends on $n$, not on $a$.)

\begin{verbatim}
    int mystery(int n) {
        if (n <= 1) { return 2; }

        m = mystery( round(n/3) );   // round() rounds to nearest integer
        m = m*m*m;

        for(i = 1; i <= n; i++) {
            m = m - i;
        }
        return m;
    }
\end{verbatim}

\begin{enumerate}
\item
Give a recurrence relation and initial conditions for $f$.
\vfill

%\item
%What are $f(1)$, $f(3)$ and $f(9)$.

%\vfill

%\item
%Solve the recurrence to find an exact formula for $f$ when $n$ is a
%power of 3.
%\vfill
%\vfill
%\vfill

\item
What is {\tt mystery(3)}?
%What is {\tt mystery(9)}?
\vfill
%What does this algorithm do?
%\item
%Give a big $\Theta$  estimate for $f(n)$ that holds for all $n$.
%
\end{enumerate}

\end{problem}

\begin{problem}
Let $t(n)$ satisfy the recurrence
$t(n) = t(n-1) + 2\, t(n-2)$ with initial conditions $t(0) = 0$ and
$t(1) = 1$.
\begin{enumerate}
\item
Compute the values of $t(2)$, $t(3)$, $t(4)$ and $t(5)$.

\bigskip

\begin{center}
\begin{tabular}{cccc}
$t(2) = \rule[-5pt]{2cm}{.5pt}$
&
$t(3) = \rule[-5pt]{2cm}{.5pt}$
&
$t(4) = \rule[-5pt]{2cm}{.5pt}$
&
$t(5) = \rule[-5pt]{2cm}{.5pt}$
\end{tabular}
\end{center}

\vfill
\item
Find an exact formula for $t(n)$.
\vfill
\vfill
\end{enumerate}
\end{problem}

\newpage

\begin{problem}
Let $g$ be an increasing function that satisfies the recurrence
$g(n) = 4 g(n/3) + n + 1$ when $n$ is a power of 3 and for which
$g(1) = 2$.
\begin{enumerate}
\item
Use unraveling to find an \emph{exact} formula for $g(n)$ when $n$ is a
power of 3.
\vfill
\item
Give a good big-O representation of $g(n)$.
[Note: there are ways to do this even if you can't do part (a).]
\vfill
\end{enumerate}
\end{problem}


