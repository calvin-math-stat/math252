\section*{Unused problems}

\begin{problem}
Answer the following questions about the graph below.

\medskip

\tikzstyle{every node}=[circle, draw, fill=black!50,
                        inner sep=0pt, minimum width=4pt]

\begin{tikzpicture}[thick,scale=0.7]%
  \draw (90:2)     node{} -- (90+180:2) node{};
  \draw (90-60:2)  node{} -- (90-120:2) node{};
  \draw (90:2)     node{} -- (90+60:2)  node{};
  \draw (90+60:2)  node{} -- (90+120:2) node{};
  \draw (90+60:2)  node{} -- (90-60:2)  node{};
  \draw (90+120:2) node{} -- (90-120:2) node{};
  \draw (90-60:2)  node{} -- (90+180:2) node{};
  \draw \foreach \x in {1,2,...,6} { (90 - \x * 60:2.4) node[fill=none,draw=none]{\x} };
\end{tikzpicture}

  \begin{enumerate}
    \item
  Does the graph have an Euler circuit?  How do you know?
  \vfill
\item
  Does the graph have a Hamilton circuit?  How do you know?
  \vfill
  \end{enumerate}
\end{problem}


