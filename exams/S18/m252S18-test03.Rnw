\begin{problem}
Below is a the state diagram for an NFA $N$.

\begin{center}

\ifversionA
\begin{tikzpicture}[->,>=stealth',shorten >=1pt,auto,node distance=2.8cm,
                    semithick, scale = 0.7]
  \tikzstyle{every state}=[fill=none,draw=black,text=black]
  \tikzstyle{every node}=[scale = 0.7]

  \node[state,initial]    (A)              {$a$};
  \node[state]            (B) [right of=A] {$b$};
  \node[state,accepting]  (C) [right of=B] {$c$};

  \path (A) edge              node {0,1} (B);
  \path (B) edge              node {1} (C);
  \path (A) edge [bend left] node {1} (C);
  \path (B) edge [loop below] node {1} (B);
  \path (C) edge [loop below] node {0} (C);
\end{tikzpicture}
\else
\begin{tikzpicture}[->,>=stealth',shorten >=1pt,auto,node distance=2.8cm,
                    semithick, scale = 0.7]
  \tikzstyle{every state}=[fill=none,draw=black,text=black]
  \tikzstyle{every node}=[scale = 0.7]

  \node[state,initial]    (A)              {$a$};
  \node[state]            (B) [right of=A] {$b$};
  \node[state,accepting]  (C) [right of=B] {$c$};

  \path (A) edge              node {0,1} (B);
  \path (B) edge              node {1} (C);
  \path (A) edge [bend left] node {1} (C);
  \path (A) edge [loop below] node {0} (A);
  \path (C) edge [loop below] node {0} (C);
\end{tikzpicture}
\fi
\end{center}



\begin{enumerate}
\item
For each string in the table below, indicate whether $N$ accepts the string.
For accepted strings, list (in order) a sequence of states the
NFA goes through to accept the string.  No other explanation needed.

\begin{center}
  \Large
\begin{tabular}{|c|c|c|}
  \hline
  string & accept? (Y or N) & sequence of states (for accepted strings)
  \\
  \hline\hline
  01 & & \\[4mm] \hline
  001 & & \\[4mm] \hline
  101 & & \\[4mm] \hline
  0101 & & \\[4mm] \hline
  0110 & & \\[4mm] \hline
\end{tabular}
\end{center}


%\item
%Draw the state diagram for an equivalent NFA that is
%$\varepsilon$-free (i.e., has no $\varepsilon$-transitions).
\item
Draw the state diagram for a DFA that accepts the same language
using an algorithm that can convert any NFA into an equivalent DFA.
(You need not show unreachable states.)
\vfill
%\item
%Describe the language accepted by $N$ with a regular expression.
\vfill
\end{enumerate}


\end{problem}


\newpage

\begin{problem}
  Let $L$ be the language that contains all and only binary
  strings that
\ifversionA
contain a 1 and end with three or more consecutive 0's.
  (So $01000 \in L$ and $110000 \in L$, but $0100 \not\in L$ and $000 \not\in L$.)
\else
contain a 0 and end with three or more consecutive 1's.
  (So $10111 \in L$ and $001111 \in L$, but $1011 \not\in L$ and $111 \not\in L$.)
\fi

  \begin{enumerate}
    \item
      Design a DFA that accepts the langauge $L$.
      \vfill
      \vfill
    \item
      Construct a regular expression for $L$.  (You do not have to use
      the algorithm that converts any DFA into a regular expression.)
      \vfill
      \vfill
  \end{enumerate}
\end{problem}

\newpage

\begin{problem}
The productions rules for a grammar $G$ with start symbol $S$,
terminals $a$, $b$, and $c$ and
non-terminals $X$, $Y$, and $Z$ is given below:
\[
\begin{array}{rcl}
G: \qquad
S & \rightarrow & XY  \\
X & \rightarrow & a \mid YZ \\
Y & \rightarrow & b\mid ZX \\
Z & \rightarrow & c\mid XY \\
\end{array}
\]
\begin{enumerate}
\item
%S -> XY -> aY -> aZX -> aZYZ -> aZYXY -> acbab
%S -> XY -> YZY -> YXYY -> YXZXY -> bacab
%S -> XY -> YZY -> ZXZY -> XYXZY -> abacb
\ifversionA
\def\target{bacab}
\else
\def\target{abacb}
\fi
Give either a derivation or a derivation tree (also called a parse tree)
that shows that $G$ generates $\target$ (i.e., that $S \stackrel*{\Rightarrow} \target$).
\vfill
\vfill
\vfill
%\item
%Give a left-most derivation that shows that
%$G \stackrel*{\Rightarrow} babb$.
%\item
%Show that $G$ is an ambiguous grammar.
%\item
%Use a systematic method to construct a PDA that recognizes the
%language that $G$ generates.
\item
Is $G$ a regular grammar?  Explain.
\vfill
\vfill
\item
Is $G$ a context free grammar?  Explain.
\vfill
\vfill
\end{enumerate}

\end{problem}

