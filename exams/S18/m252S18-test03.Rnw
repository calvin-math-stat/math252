\begin{problem}
Explain how we know that $\{0^n1^n \mid n = 0, 1, 2, \dots \}$ is not
a regular language.
\end{problem}

\vfill
\vfill

\begin{problem}
Show that if $A$ is a regular language,
then $\overline{A} = \{x \mid x\not \in A\}$ is also regular.
\end{problem}

\vfill
\vfill

