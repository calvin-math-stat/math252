\begin{problem}
{\bf How many isomorphisms} are there between the following two graphs?
{\bf Explain.}
\medskip

(If you do not know exactly how many there are, tell me
as much as you know about how many there are.
Examples: There are at least 3; there are at most 2, etc.)

\tikzstyle{every node}=[circle, draw, fill=black!50,
                        inner sep=0pt, minimum width=4pt]

<<echo = FALSE, results = "asis">>=
graphs2 <- function(version) {
  skafold <- "
\\begin{tikzpicture}[thick,scale=0.9]%
  \\draw (90+ 0:2) node{} -- (90+ <<degree3>>:2) node{};
  \\draw (90+ 0:2) node{} -- (90- <<degree3>>:2) node{};
  \\draw (90+<<degree3>>:2) node{} -- (90+<<fourfive>>:2) node{};
  \\draw (90-<<degree3>>:2) node{} -- (90-<<fourfive>>:2) node{};
  \\draw (90:2)    node{} -- (90<<pm>><<other>>:2) node{};
  \\draw (90:2)    node{} -- (90<<mp>><<other>>:2) node{};
  \\draw (90-<<fourfive>>:2) node{} -- (90+<<fourfive>>:2) node{};
  \\draw (90-<<degree3>>:2) node{} -- (90<<pm>><<other>>:2) node{};
  \\draw (90+<<degree3>>:2) node{} -- (90<<mp>><<other>>:2) node{};
  \\draw (90:2.4) node[draw=none, fill=none]{a};
  \\draw (90-50:2.4) node[draw=none, fill=none]{b};
  \\draw (90-100:2.4) node[draw=none, fill=none]{c};
  \\draw (90-150:2.4) node[draw=none, fill=none]{d};
  \\draw (90+150:2.4) node[draw=none, fill=none]{e};
  \\draw (90+100:2.4) node[draw=none, fill=none]{f};
  \\draw (90+50:2.4) node[draw=none, fill=none]{g};
\\end{tikzpicture}
\\hfill
\\begin{tikzpicture}[thick,scale=0.9]%
  \\draw (90+ 0:2) node{} -- (90+ 50:2) node{};
  \\draw (90+ 0:2) node{} -- (90- 50:2) node{};
  \\draw (90+50:2) node{} -- (90+100:2) node{};
  \\draw (90-50:2) node{} -- (90-100:2) node{};
  \\draw (90+100:2)node{} -- (90+150:2) node{};
  \\draw (90-100:2)node{} -- (90-150:2) node{};
  \\draw (90:2)    node{} -- (90+100:2) node{};
  \\draw (90:2)    node{} -- (90-100:2) node{};
  \\draw (90+150:2)node{} -- (90-150:2) node{};
  \\draw (90:2.4) node[draw=none, fill=none]{1};
  \\draw (90-50:2.4) node[draw=none, fill=none]{2};
  \\draw (90-100:2.4) node[draw=none, fill=none]{3};
  \\draw (90-150:2.4) node[draw=none, fill=none]{4};
  \\draw (90+150:2.4) node[draw=none, fill=none]{5};
  \\draw (90+100:2.4) node[draw=none, fill=none]{6};
  \\draw (90+50:2.4) node[draw=none, fill=none]{7};
\\end{tikzpicture}
"

  # which are at angle 50; which at angle 100; which at 150?
  degree3  <- c( 50,  50, 150, 100)[1 + version %% 4]
  fourfive <- c(100, 100, 100,  50)[1 + version %% 4]
  other    <- c(150, 150,  50, 150)[1 + version %% 4]
  one_side <- c("-", "+", "-", "-")[1 + version %% 4]
  other_side <- ifelse(one_side == "+", "-", "+")

  glue::glue(
    skafold,
    pm = one_side,
    mp  = other_side,
    degree3 = degree3,
    fourfive = fourfive,
    other = other,
    .open = "<<", .close = ">>")
}
graphs2(version = test_version)
@

\vfill
\vfill
\vfill
\end{problem}



