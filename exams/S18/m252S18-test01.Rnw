\begin{problem}
Answer the following questions about the graph below.

\tikzstyle{every node}=[circle, draw, fill=black!50,
                        inner sep=0pt, minimum width=4pt]

<<echo = FALSE, results = "asis">>=
graph <- function(base) {
  skafold <- "
\\begin{tikzpicture}[thick,scale=0.7]%
  \\draw (<<b>>:2)     node{} -- (<<b>>+180:2) node{};
  \\draw (<<b>>-60:2)  node{} -- (<<b>>-120:2) node{};
  \\draw (<<b>>:2)     node{} -- (<<b>>+60:2)  node{};
  \\draw (<<b>>+60:2)  node{} -- (<<b>>+120:2) node{};
  \\draw (<<b>>+60:2)  node{} -- (<<b>>-120:2) node{};
  \\draw (<<b>>+60:2)  node{} -- (<<b>>-60:2)  node{};
  \\draw (<<b>>+120:2) node{} -- (<<b>>-120:2) node{};
  \\draw (<<b>>-60:2)  node{} -- (<<b>>+180:2) node{};
  \\draw \\foreach \\x in {1,2,...,6} { (150 - \\x * 60:2.4) node[fill=none,draw=none]{\\x} };
\\end{tikzpicture}
"
  glue::glue(skafold, b = base, .open = "<<", .close = ">>")
}
graph(base = seq(30, 30 + 60 * 4, by = 60)[1 + test_version %% 4])
@


\medskip


