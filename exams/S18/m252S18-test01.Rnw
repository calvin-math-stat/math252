\begin{problem}
% Binomial coeffcients.
\begin{enumerate}
\item
  Show how to calculate $C(\Sexpr{n}, \Sexpr{k}) = {\Sexpr{n} \choose \Sexpr{k}} = $ \textbf{without a
    calculator. Show your work.}
\vfill
\item
Write a counting problem for which $\Sexpr{n} \choose \Sexpr{k}$ gives the anwer.
(Keep your problem simple.)
\vfill
\end{enumerate}
\end{problem}


<<include = FALSE>>=
D <- data_frame(
  kinds = c(6,5,5,6),
  order_size = c(9, 10, 8, 10),
  orders = choose(order_size + kinds - 1, order_size)
)
@

\begin{problem}
A bagel shop has \Sexpr{D$kinds[1 + test_version %% 4]}  types of bagels.
How many ways are there to select
\Sexpr{D$order_size[1 + test_version %% 4]} bagels?
\vfill

\end{problem}


