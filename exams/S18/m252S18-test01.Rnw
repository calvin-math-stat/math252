  \vfill
\item
  What is a Hamilton circuit? Does this graph have a Hamilton circuit?  How do you know?
  \vfill

  \item
  What is a bipartite graph? Is this graph bipartite?  How do you know?
  \vfill

  \item
  What is a planar graph? Is this graph planar?  How do you know?

  \vfill

  \end{enumerate}
\end{problem}


