\begin{problem}
Bitstrings
\begin{enumerate}
\item
  How many bitstrings of length 8 are there?
  \vfill
\item
  How many bitstrings of length 8 have \emph{exactly} 5 1's?
	\vfill
\item
  How many bitstrings of length 8 have \emph{at least} 5 1's?
	\vfill
\item
	How many bitstrings of length 8 have at least 5 {\em consecutive} 1's?
	\vfill
\end{enumerate}
\end{problem}

