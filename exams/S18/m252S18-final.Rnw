\begin{problem}
{\sc ABC-123 Lottery.}
Consider the following lottery type game:
A player selects (in order)
three {\em distinct} letters from A to Z and
three {\em distinct} digits from 0 to 9.
(Examples: one lottery ticket would be AZD-924, another would be ADZ-492.
On the other hand,
ABA-012 is not a legal ticket because A is repeated
and 123-ABC is not a legal ticket because the numbers come first.)
Later, the lottery commission draws three distinct letters and three distinct
digits at random and in order.
\begin{itemize}
\item
If all the numbers and letters match in order,
then the player wins \$1,000,000.
\item
If all the numbers and letters match but are not in the correct order,
then the player wins \$100,000.
\item
If the all the letters match (not necessarily in order), but the numbers
do not, then the player wins \$1,000;
\item
If the all the numbers match (not necessarily in order), but the letters
do not, then the player wins a prize of \$10;
\item
In all other cases, the player wins nothing.
\end{itemize}

\begin{enumerate}
\item
Fill in the following table.  Show your work in the space below.
% [I will give values for selected
% cells if you are stuck, or can't get all of them.]

\begingroup
\Large
\begin{tabular}{|c||c|c|c|c|c|}
\hline
amount won & 1,000,000 & 100,000 & 1000 & 10 & 0 \\
\hline
\hline
probability &
\phantom{XXXXXXX} &
\phantom{XXXXXXX} &
\phantom{XXXXX} &
\phantom{XXXXX} &
\phantom{XXXXX} \\
\hline
\end{tabular}
\endgroup

\vfill
\vfill
\vfill
\vfill
\vfill

\iffalse
\item
What is $P(W=100)$?
(That is, what is the probability of winning \$100?)
\item
What is $P(W=5)$?
\item
What is $P(W=2)$
\item
What is $P(W=0)$?
\item
What is $P(W>0)$?
\fi
\item
Determine the {\bf expected value} of the amount won from one lottery ticket.
[This will be graded based on your
answers to the questions above, even if they are incorrect, so be
sure to show your work.]

\vfill
\vfill
\item
How much must the lottery charge per play to avoid losing money at
this game?
\vfill
\item
%(Extra credit.)
For which kind of prize should the lottery commission
expect to pay out the most money?  Explain.
\end{enumerate}
\end{problem}

\begin{solution}

<<>>=
vals <- c(1000000, 100000, 1000, 10, 0)
plays <- (26*25*24*10*9*8); plays
probs <- 1/plays * c(
  1,                             # perfect match (in order)
  3 * 2 * 1 * 3 * 2 * 1 - 1,     # correct but in wrong order
  3 * 2 * 1 * (10 * 9 * 8 - 3 * 2 * 1),   # letters correct, numbers not
  3 * 2 * 1 * (26 * 25 * 24 - 3 * 2 * 1)  # numbers correct, letters not
)
probs <- c(probs, 1 - sum(probs)); probs
probs * plays
sum(probs * vals)
probs * vals

1/probs

1 /
  c(11232000,
    (choose(26, 3) - 1 ) * (choose(10, 3) - 1),
    (choose(26, 3) - 1) * choose(10, 3) / (choose(10, 3) - 1),
    (choose(10, 3) - 1) * choose(26, 3) / (choose(26, 3) - 1),
    1) /
  probs

@
\end{solution}


\newpage


\begin{problem}
Sam collects commemorative stamps.  Among his favorites
are Maria Goeppert Mayer stamps
\includegraphics[height=.4in]{images/MariaGoeppertMayer}
and the new cowaphant stamps.
\fbox{\includegraphics[height=.35in]{images/cowaphant-with-hat}}

\bigskip

On Sam's desk are four envelopes with stamps in them.  The table below
shows how many of each kind of stamp are in each envelope.
\begin{center}
\begin{tabular}{|c|c|c|}
\hline
&
\includegraphics[height=.4in]{images/MariaGoeppertMayer}
&
\fbox{\includegraphics[height=.30in]{images/cowaphant-with-hat}}
\\
envelope & Maria Goeppert Mayer & cowaphant
\\
\hline \hline
A & 1 & 4 \\
\hline
B & 3 & 7 \\
\hline
C & 10 & 10 \\
\hline
D & 18 & 2 \\
\hline

\end{tabular}
\end{center}
Sam randomly selects an envelope (each envelope equally likely)
and then randomly selects a stamp from within that envelope (each
stamp in the envelope equally likely).
\begin{enumerate}
\item
What is the probability that Sam chooses a cowaphant stamp?
\vfill
\item
If Sam chooses a cowaphant stamp, what is the probability that
the envelope was envelope A?
\vfill
\end{enumerate}
\end{problem}

\begin{solution}
<<>>=
sum(.25 * c(4/5, 7/10, 1/2, 1/10))
sum(.25 * c(4/5, 7/10, 1/2, 1/10)) %>% fractions()
.25 * c(4/5, 7/10, 1/2, 1/10) / sum(.25 * c(4/5, 7/10, 1/2, 1/10))
.25 * c(4/5, 7/10, 1/2, 1/10) / sum(.25 * c(4/5, 7/10, 1/2, 1/10)) %>% fractions()
@
\end{solution}

