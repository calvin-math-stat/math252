\begin{problem}
\textsc{Coins and Cards.}
\begin{enumerate}
\item
If I flip a coin 5 times, what is the probability of getting the same
result each of the five times?
\vfill
\item
If I deal five cards from a standard 52 card deck, what is the probability
that they will all be the same color. (The deck has 26 red cards and 26 black
cards.)
\vfill
\end{enumerate}
\end{problem}


\begin{problem}
