\begin{problem}
Dice.
\begin{enumerate}
\item
If you roll three dice (each with six sides numbered 1, 2, 3, 4, 5, and 6),
what is the probability that the three numbers rolled will all be the same?
\vfill
\item
If you roll three dice (each with six sides numbered 1, 2, 3, 4, 5, and 6),
what is the probability that the three numbers rolled will be distinct?
(no repetitions)
\vfill
\end{enumerate}
\end{problem}



\begin{problem}
What is the output of the following python code?

\begin{alltt}
>>> import re as re
>>> re.findall(r'a+b*[cd]*', 'abcdabcddcbaabbccddccbbaa')
\end{alltt}
\end{problem}
\vfill

\begin{solution}
\begin{alltt}
>>> import re as re
>>> re.findall(r'a+b*[cd]*', 'abcdabcddcbaabbccddccbbaa')
['abcd', 'abcddc', 'aabbccddcc', 'aa']
\end{alltt}
\end{solution}


