\begin{problem}
Below is the state diagram for an NFA $N$.

\begin{center}
\small
\begin{tikzpicture}[->,>=stealth',shorten >=1pt,auto,node distance=2.8cm,
                    semithick,scale=.9]
  \tikzstyle{every state}=[fill=white,draw=black,text=black]

  \node[state]             (B) {$B$};
  \node[initial,state]     (A) [below left of=B] {$A$};
  \node[accepting,state]   (C) [below right of=B] {$C$};

  \path (A) edge              node {1} (B)
            edge              node {0} (C)
        (B) edge [loop above] node {0} (B)
            edge              node {0} (C)
        (C) edge [loop right] node {1} (C)
            edge [bend left]  node {1} (A);
\end{tikzpicture}

\end{center}

\medskip

\begin{enumerate}
\item
	Which of the following strings are accepted by $N$?
	(Simply write ``accept'' or ``reject'' after each.)

	\medskip
	\begin{multicols}{2}
	\begin{itemize}
\item 101
	\medskip
\item 0011
	\medskip
\item 0100
	\medskip
\item 1001
	\medskip
\item 0101
	\medskip
\item 01100
	\medskip
	\end{itemize}
	\end{multicols}

\item
Design a DFA that accepts the same language as $N$ using
a general method that works for all NFAs.
\vfill
\vfill
\vfill
\item
Construct a regular grammar for this language using
a general method that works for all NFAs.
\vfill
\vfill
\end{enumerate}
\end{problem}

\begin{solution}
\verb!(01 | 10*01*1)* 10*01*!
\end{solution}

