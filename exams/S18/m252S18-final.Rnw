\begin{problem}
Answer the following questions about the graph below.

\medskip

\tikzstyle{every node}=[circle, draw, fill=black!50,
                        inner sep=0pt, minimum width=4pt]

\ifversionA
\begin{tikzpicture}[thick,scale=0.7]%
  \foreach \base in {90 + 2 * 60} {
  \draw (\base:2)     node{} -- (\base+180:2) node{};
  \draw (\base-60:2)  node{} -- (\base-120:2) node{};
  \draw (\base:2)     node{} -- (\base+60:2)  node{};
  \draw (\base+60:2)  node{} -- (\base+120:2) node{};
  \draw (\base+60:2)  node{} -- (\base-60:2)  node{};
  \draw (\base+120:2) node{} -- (\base-120:2) node{};
  \draw (\base-60:2)  node{} -- (\base+180:2) node{};
  }
  \draw \foreach \x in {1,2,...,6} { (90 - \x * 60:2.4) node[fill=none,draw=none]{\x} };
\end{tikzpicture}
\else
\begin{tikzpicture}[thick,scale=0.7]%
  \foreach \base in {90 - 1 * 60} {
  \draw (\base:2)     node{} -- (\base+180:2) node{};
  \draw (\base-60:2)  node{} -- (\base-120:2) node{};
  \draw (\base:2)     node{} -- (\base+60:2)  node{};
  \draw (\base+60:2)  node{} -- (\base+120:2) node{};
  \draw (\base+60:2)  node{} -- (\base-60:2)  node{};
  \draw (\base+120:2) node{} -- (\base-120:2) node{};
  \draw (\base-60:2)  node{} -- (\base+180:2) node{};
  }
  \draw \foreach \x in {1,2,...,6} { (90 - \x * 60:2.4) node[fill=none,draw=none]{\x} };
\end{tikzpicture}

\fi

\begin{enumerate}
  \item
    What is an Euler circuit?
    \vfill
  \item
    Does the graph have an Euler circuit?  How do you know?
  \vfill
  \item
    Does the graph have an Euler path that is not a circuit?  How do you know?
  \vfill
  \item
    What is a Hamilton circuit?
\vfill
  \item
    Does the graph have a Hamilton circuit?  How do you know?
  \vfill
  \end{enumerate}
\end{problem}

